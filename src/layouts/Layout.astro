---
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #0f1115;
        --fg: #e6e6e6;
        --muted: #9aa0a6;
        --accent: #7dd3fc;
        --ok: #4ade80;
        --err: #f87171;
        --box: #1a1d23;
      }
      @media (prefers-color-scheme: light) {
        :root {
          --bg: #ffffff;
          --fg: #111;
          --muted: #555;
          --accent: #0369a1;
          --ok: #15803d;
          --err: #b91c1c;
          --box: #f3f4f6;
        }
      }
      * {
        box-sizing: border-box;
      }
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          Segoe UI,
          Roboto,
          sans-serif;
      }
      a {
        color: var(--accent);
      }
      code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        background: var(--box);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
      }
    </style>
  </body>
</html>
